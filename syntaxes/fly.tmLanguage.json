{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fly",
  "scopeName": "source.fly",
  "fileTypes": ["fly", "fly.h"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#raw-strings" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#annotations" },
    { "include": "#type-declarations" },
    { "include": "#generic-type-params" },
    { "include": "#keywords-control" },
    { "include": "#ownership" },
    { "include": "#keywords-other" },
    { "include": "#modifiers" },
    { "include": "#builtin-types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#function-calls" },
    { "include": "#function-declarations" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.block.fly",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.fly" } },
          "endCaptures":   { "0": { "name": "punctuation.definition.comment.end.fly" } }
        },
        {
          "name": "comment.line.double-slash.fly",
          "begin": "//",
          "end": "$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.fly" } }
        }
      ]
    },

    "raw-strings": {
      "comment": "Raw literal (0.15): \"\"\"...\"\"\" has no escape sequences and may span lines",
      "name": "string.quoted.triple.fly",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fly" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.fly" } }
    },

    "strings": {
      "name": "string.quoted.double.fly",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fly" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.fly" } },
      "patterns": [
        { "include": "#escape-sequences" }
      ]
    },

    "chars": {
      "name": "string.quoted.single.fly",
      "begin": "'",
      "end": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fly" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.string.end.fly" } },
      "patterns": [
        { "include": "#escape-sequences" }
      ]
    },

    "escape-sequences": {
      "comment": "0.15 escapes, decoded by the compiler: \\n \\t \\r \\0 \\\\ \\\" \\' \\xHH \\u{H..}; any other backslash sequence is a compile error",
      "patterns": [
        {
          "name": "constant.character.escape.fly",
          "match": "\\\\(?:[ntr0\\\\\"']|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.fly",
          "match": "\\\\."
        }
      ]
    },

    "ownership": {
      "comment": "Contextual ownership qualifiers: new unique / new shared, and = weak h (not reserved words)",
      "patterns": [
        {
          "match": "\\b(new)\\s+(unique|shared)\\b",
          "captures": {
            "1": { "name": "keyword.other.fly" },
            "2": { "name": "storage.modifier.ownership.fly" }
          }
        },
        {
          "match": "(?<==)\\s*(weak)\\b",
          "captures": { "1": { "name": "storage.modifier.ownership.fly" } }
        }
      ]
    },

    "annotations": {
      "name": "meta.annotation.fly",
      "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.fly" },
        "2": { "name": "entity.name.type.annotation.fly" }
      }
    },

    "type-declarations": {
      "patterns": [
        {
          "comment": "class / struct / interface / enum / suite Name",
          "match": "\\b(class|struct|interface|enum|suite)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.fly" },
            "2": { "name": "entity.name.type.fly" }
          }
        }
      ]
    },

    "keywords-control": {
      "name": "keyword.control.fly",
      "match": "\\b(if|elsif|else|switch|case|default|for|in|while|return|break|continue|fail|handle|test)\\b"
    },

    "keywords-other": {
      "name": "keyword.other.fly",
      "match": "\\b(namespace|import|as|new|delete)\\b"
    },

    "generic-type-params": {
      "comment": "Generic type parameters in declarations: class Wrapper<T>, List<string>, Map<K,V>",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(<[^>{}()]+>)",
      "captures": {
        "1": { "name": "entity.name.type.fly" },
        "2": { "name": "storage.type.fly" }
      }
    },

    "modifiers": {
      "name": "storage.modifier.fly",
      "match": "\\b(public|private|protected|const|static|abstract|final)\\b"
    },

    "builtin-types": {
      "name": "support.type.fly",
      "match": "\\b(bool|byte|short|ushort|int|uint|long|ulong|pointer|float|double|complex|string|void|error)\\b"
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.fly",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "this and super are not reserved words, but they always mean the object",
          "name": "variable.language.fly",
          "match": "\\b(this|super)\\b"
        },
        {
          "name": "constant.language.null.fly",
          "match": "\\bnull\\b"
        }
      ]
    },

    "numbers": {
      "comment": "No hex/binary/octal literals in Fly — decimal integers and floats only",
      "patterns": [
        {
          "name": "constant.numeric.float.fly",
          "match": "\\b[0-9]+\\.[0-9]*\\b"
        },
        {
          "name": "constant.numeric.integer.fly",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "function-declarations": {
      "comment": "identifier followed by '(' that is NOT a call — used to highlight declared names",
      "match": "(?<![.])\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.fly" }
      }
    },

    "function-calls": {
      "comment": "member.method() — highlight the method name only",
      "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.member.fly" }
      }
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.fly",
          "match": "(?<!=)(=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)(?!=)"
        },
        {
          "name": "keyword.operator.comparison.fly",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.fly",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.fly",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.arithmetic.fly",
          "match": "(\\+\\+|--|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.ternary.fly",
          "match": "[?:]"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.brackets.fly",
          "match": "[()\\[\\]{}]"
        },
        {
          "name": "punctuation.separator.fly",
          "match": "[.,;]"
        }
      ]
    }
  }
}
