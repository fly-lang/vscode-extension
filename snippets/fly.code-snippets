{
  "Namespace": {
    "prefix": "ns",
    "body": ["namespace ${1:com.example}", ""],
    "description": "Namespace declaration"
  },

  "Import namespace": {
    "prefix": "import",
    "body": ["import ${1:fly.str}"],
    "description": "Namespace import — access symbols with prefix: str.len()"
  },

  "Import class (Java style)": {
    "prefix": "importc",
    "body": ["import ${1:fly.data.List}"],
    "description": "Java-style class import — brings the type directly into scope: List l = new List()"
  },

  "Import wildcard": {
    "prefix": "importw",
    "body": ["import ${1:fly.data}.*"],
    "description": "Wildcard import — brings all public symbols from namespace into scope"
  },

  "Import with alias": {
    "prefix": "importas",
    "body": ["import ${1:fly.str} as ${2:s}"],
    "description": "Import with alias"
  },

  "Main function": {
    "prefix": "main",
    "body": [
      "void main() {",
      "\t$0",
      "}"
    ],
    "description": "Main entry point"
  },

  "Function (void)": {
    "prefix": "fn",
    "body": [
      "void ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Void function declaration"
  },

  "Public function (void)": {
    "prefix": "pfn",
    "body": [
      "public void ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Public void function declaration"
  },

  "Function with return type": {
    "prefix": "fnr",
    "body": [
      "${1:int} ${2:name}(${3}) {",
      "\treturn $0",
      "}"
    ],
    "description": "Function with return type — every path must return a value"
  },

  "Public function with return type": {
    "prefix": "pfnr",
    "body": [
      "public ${1:int} ${2:name}(${3}) {",
      "\treturn $0",
      "}"
    ],
    "description": "Public function with return type — every path must return a value"
  },

  "Generic function": {
    "prefix": "fng",
    "body": [
      "${1:T} ${2:name}<${1:T}>(const ${1:T} ${3:v}) {",
      "\treturn $0",
      "}"
    ],
    "description": "Generic function — type parameter T, inferred at call site"
  },

  "Class": {
    "prefix": "class",
    "body": [
      "public class ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Class declaration"
  },

  "Class with base": {
    "prefix": "classx",
    "body": [
      "public class ${1:Name} : ${2:Base} {",
      "\t$0",
      "}"
    ],
    "description": "Class declaration with base class or interface"
  },

  "Generic class": {
    "prefix": "classg",
    "body": [
      "public class ${1:Name}<${2:T}> {",
      "\t$0",
      "}"
    ],
    "description": "Generic class declaration — instantiated as Name<int>, Name<string>, etc."
  },

  "Struct": {
    "prefix": "struct",
    "body": [
      "public struct ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Struct declaration (stack-allocated by default)"
  },

  "Interface": {
    "prefix": "iface",
    "body": [
      "public interface ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Interface declaration"
  },

  "Enum": {
    "prefix": "enum",
    "body": [
      "public enum ${1:Name} {",
      "\t${2:VALUE1},",
      "\t${3:VALUE2}",
      "}"
    ],
    "description": "Enum declaration"
  },

  "Suite": {
    "prefix": "suite",
    "body": [
      "suite ${1:Name} {",
      "",
      "\tvoid setup() {",
      "\t\t$0",
      "\t}",
      "",
      "\tvoid teardown() {",
      "\t\t",
      "\t}",
      "",
      "\tvoid ${2:name}Test() {",
      "\t\tcase \"${3:label}\": $4",
      "\t}",
      "}"
    ],
    "description": "Suite declaration with setup/teardown lifecycle hooks and one test-method"
  },

  "Test method": {
    "prefix": "testm",
    "body": [
      "void ${1:name}Test() {",
      "\tcase \"${2:label}\": $0",
      "}"
    ],
    "description": "Suite test-method — name must end with 'Test'. Contains case blocks that all execute sequentially."
  },

  "Test block (inline)": {
    "prefix": "testb",
    "body": [
      "test {",
      "\t$0",
      "}"
    ],
    "description": "Inline test block — written inside a production function to observe local state. Completely stripped in release builds; activated by a suite in test mode."
  },

  "Test case": {
    "prefix": "tcase",
    "body": ["case \"${1:label}\": $0"],
    "description": "Named case step inside a suite test-method — all cases execute sequentially. Each has its own isolated error scope."
  },

  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If statement"
  },

  "If / else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "} else {",
      "\t",
      "}"
    ],
    "description": "If / else statement"
  },

  "If / elsif / else": {
    "prefix": "ifee",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "} elsif ${2:condition} {",
      "\t",
      "} else {",
      "\t",
      "}"
    ],
    "description": "If / elsif / else statement"
  },

  "Switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:expr} {",
      "\tcase ${2:value}:",
      "\t\t$0",
      "\tdefault:",
      "\t\t",
      "}"
    ],
    "description": "Switch statement — no fall-through: a case ends where the next begins"
  },

  "For": {
    "prefix": "for",
    "body": [
      "for int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++ {",
      "\t$0",
      "}"
    ],
    "description": "For loop"
  },

  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },

  "New (class instance)": {
    "prefix": "new",
    "body": ["${1:Type} ${2:obj} = new ${1:Type}($3)"],
    "description": "Class instance on the heap — released only by 'delete'; nothing happens at scope exit"
  },

  "New unique (scope-bound owner)": {
    "prefix": "newu",
    "body": ["${1:Type} ${2:obj} = new unique ${1:Type}($3)"],
    "description": "One owner — released at the end of its scope; assignment and return move it"
  },

  "New shared (reference counted)": {
    "prefix": "news",
    "body": ["${1:Type} ${2:obj} = new shared ${1:Type}($3)"],
    "description": "Reference-counted object — released with its last holder"
  },

  "Weak reference": {
    "prefix": "weak",
    "body": ["${1:Type} ${2:ref} = weak ${3:holder}"],
    "description": "Observe a 'new shared' object without holding it — reads null once it is gone"
  },

  "Delete": {
    "prefix": "del",
    "body": ["delete ${1:obj}"],
    "description": "Release an object made with plain 'new' — runs free() if declared, then sets the variable to null"
  },

  "For in": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Iterate an array or a collection"
  },

  "Constructor": {
    "prefix": "ctor",
    "body": [
      "public ${1:Name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Constructor — no return type; a base constructor runs only if called with super(...)"
  },

  "Const field": {
    "prefix": "cfield",
    "body": ["const ${1:int} ${2:name}"],
    "description": "Instance const field — written once, in a constructor of this class (or give it an initializer)"
  },

  "Static const": {
    "prefix": "sconst",
    "body": ["static const ${1:int} ${2:NAME} = ${3:0}"],
    "description": "Class constant — set only by its (constant) initializer"
  },

  "Return (value)": {
    "prefix": "ret",
    "body": ["return $0"],
    "description": "Return a value — written into the caller's slot, then ret. Every path of a value function must return"
  },

  "Return (multi-value)": {
    "prefix": "retm",
    "body": ["return ${1:a}, ${2:b}"],
    "description": "Return one value per declared return type, in order: int,int func()"
  },

  "Return (early exit)": {
    "prefix": "rete",
    "body": ["return"],
    "description": "Exit a void function early — a bare return carries no value"
  },

  "Fail": {
    "prefix": "fail",
    "body": ["fail ${1:\"error message\"}"],
    "description": "Signal an error — accepts int code, string message, and/or object (comma-separated)"
  },

  "Handle block": {
    "prefix": "handle",
    "body": [
      "handle {",
      "\t$0",
      "}"
    ],
    "description": "Handle block — guards the statements inside; binds the implicit 'error' variable"
  },

  "Handle with error check": {
    "prefix": "errhandle",
    "body": [
      "handle {",
      "\t$0",
      "}",
      "if error {",
      "\t",
      "}"
    ],
    "description": "Handle block followed by a check of the implicit 'error' variable"
  },

  "Handle single call": {
    "prefix": "errh",
    "body": ["handle { ${1:operation()} }"],
    "description": "Guard a single call — check 'if error' afterwards"
  },

  "Line comment": {
    "prefix": "//",
    "body": ["// $0"],
    "description": "Line comment"
  },

  "Block doc comment": {
    "prefix": "/**",
    "body": [
      "/**",
      " * $0",
      " */"
    ],
    "description": "Block doc comment"
  },

  "Class field": {
    "prefix": "field",
    "body": ["${1|public,private,protected|} ${2:int} ${3:name}${4: = ${5:0}}"],
    "description": "Class field declaration — the optional initializer runs at creation, before any constructor"
  },

  "Array declaration": {
    "prefix": "arr",
    "body": ["${1:int}[] ${2:arr} = { ${3:1, 2, 3} }"],
    "description": "Array declaration with a literal — iterate with 'for x in arr'; no indexing or .length"
  },

  "Generic list": {
    "prefix": "list",
    "body": ["import fly.data.List", "", "List<${1:int}> ${2:items} = new List<${1:int}>()"],
    "description": "Fly generic List"
  },

  "Interface with method": {
    "prefix": "ifacem",
    "body": [
      "public interface ${1:IName} {",
      "\t${2:void} ${3:method}(${4})",
      "}"
    ],
    "description": "Interface declaration with one abstract method"
  },

  "Getter and setter": {
    "prefix": "getset",
    "body": [
      "public ${1:int} get${2:Name}() {",
      "\treturn ${3:_field}",
      "}",
      "",
      "public void set${2:Name}(const ${1:int} value) {",
      "\t${3:_field} = value",
      "}"
    ],
    "description": "Getter and setter for a field"
  }
}
